{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/(.*\\.[a-zA-Z0-9]+)", "destination": "/source/$1" },
    { "source": "/(.*)", "destination": "/source/index.html" }
  ]
}
